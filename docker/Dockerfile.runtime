FROM --platform=$TARGETPLATFORM debian:bookworm-slim

ARG TARGETARCH
ARG BROWSER_BINARY=agent-browser-linux-x64

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates python3 python3-venv python3-pip \
      libgtk-3-0 libpangocairo-1.0-0 libpango-1.0-0 libatk1.0-0 \
      libatk-bridge2.0-0 libatspi2.0-0 libcairo-gobject2 libcairo2 \
      libgdk-pixbuf-2.0-0 libcups2 libdbus-1-3 libasound2 libnss3 \
      libnss3-tools libnspr4 libdrm2 libxkbcommon0 libgbm1 libxshmfence1 \
      libxcb-shm0 libx11-xcb1 libx11-6 libxcb1 libxext6 libxrandr2 \
      libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 libxrender1 \
      libfreetype6 libfontconfig1 \
      fonts-noto-color-emoji fonts-noto-cjk fonts-freefont-ttf \
      xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY agent-browser/bin/${BROWSER_BINARY} /usr/local/bin/agent-browser
RUN chmod 0755 /usr/local/bin/agent-browser

COPY agent-browser/skill-data/ /usr/local/share/agent-browser/skill-data/

ENV HOME=/data/home \
    AGENT_BROWSER_ENGINE=camoufox \
    AGENT_BROWSER_CAMOUFOX_RUNTIME=/opt/agent-browser/camoufox-runtime \
    AGENT_BROWSER_SOCKET_DIR=/run/agent-browser \
    AGENT_BROWSER_SKILLS_DIR=/usr/local/share/agent-browser/skill-data

RUN mkdir -p /data/home /data/screenshots /run/agent-browser \
    && agent-browser --engine camoufox install

COPY agent-browser/scripts/camoufox-guard-patch.py /tmp/camoufox-guard-patch.py
COPY camoufox/additions/juggler/Helper.js /tmp/guards/Helper.js
COPY camoufox/additions/juggler/protocol/PageHandler.js /tmp/guards/protocol/PageHandler.js
COPY camoufox/additions/juggler/TargetRegistry.js /tmp/guards/TargetRegistry.js
COPY camoufox/additions/juggler/input/MouseDispatch.js /tmp/guards/input/MouseDispatch.js
RUN python3 /tmp/camoufox-guard-patch.py --source /tmp/guards \
    && rm -rf /tmp/guards /tmp/camoufox-guard-patch.py

VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/agent-browser"]
CMD ["--engine", "camoufox", "--session", "camoufox-task", "mcp", "--tools", "core,gestures"]
